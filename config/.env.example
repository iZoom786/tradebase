# Tradebase Platform Environment Configuration
# Copy this file to .env and fill in values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=tradebase
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_MAX_RECONNECT=10
NATS_PING_INTERVAL=60
NATS_CONNECT_TIMEOUT=5

# JWT/NKey Authentication (for account server)
JWT_ISSUER_SEED=
JWT_DEFAULT_EXPIRY_HOURS=720
JWT_ENABLE_RESOLVER=true

# Subscription Service Configuration
SUBSCRIPTION_API_PORT=8002
SUBSCRIPTION_DEFAULT_TRIAL_DAYS=30
SUBSCRIPTION_MAX_SUBSCRIPTION_DAYS=365
SUBSCRIPTION_MIN_SUBSCRIPTION_DAYS=1

# Feature Configuration
FEATURE_ENABLED_INDICATORS=rsi,elder,bollinger,atr
FEATURE_CACHE_TTL_SECONDS=300
FEATURE_LOOKBACK_BARS=100

# ML Configuration
ML_MODEL_PATH=models/
ML_RETRAIN_INTERVAL_HOURS=168
ML_VALIDATION_SPLIT=0.2

# Ingestion Configuration
INGESTION_PROVIDER=yfinance
INGESTION_SYMBOLS=EURUSD,GBPUSD,USDJPY
INGESTION_INTERVAL=1m
INGESTION_BACKFILL_DAYS=365

# Observability
OBS_JAEGER_ENDPOINT=http://localhost:16686
OBS_PROMETHEUS_PORT=9090
OBS_LOG_LEVEL=INFO
